# ==============================================================================
# PT HTI Tool & Equipment Inventory System (HTI-TEIS) — Environment Template
# Copy ke .env dan ganti seluruh nilai CHANGE_ME sebelum menjalankan stack.
# DILARANG keras melakukan commit berkas .env ke Git (SRS-SEC-015).
# ==============================================================================

NODE_ENV=production
PORT=3000
TZ=Asia/Jakarta
LOG_LEVEL=info

# PostgreSQL 16 (Migrator / Owner credentials — hanya dipakai saat init & migrasi)
POSTGRES_DB=hti_inventory
POSTGRES_USER=hti_migrator
POSTGRES_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_PASSWORD_32CHARS

# Least-privilege runtime DB role (dilarang UPDATE/DELETE pada stock_logs)
APP_DB_USER=hti_app
APP_DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD_32CHARS

# Connection strings
# Runtime API menggunakan role least-privilege 'hti_app'
DATABASE_URL=postgresql://hti_app:CHANGE_ME_STRONG_APP_PASSWORD_32CHARS@postgres:5432/hti_inventory?schema=public
# Prisma Migrate & Python ETL menggunakan role pemilik skema 'hti_migrator'
DIRECT_DATABASE_URL=postgresql://hti_migrator:CHANGE_ME_STRONG_MIGRATOR_PASSWORD_32CHARS@postgres:5432/hti_inventory?schema=public

# JWT Secrets — wajib >= 256-bit random hex (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS Whitelist (dipisah koma; dilarang '*' di produksi)
CORS_ORIGINS=https://inv.hti.co.id

# Upload & Storage (ISO 45001 Evidence)
STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=/app/storage/evidence
UPLOAD_MAX_MB=2

# Client Version Compatibility Info (GET /api/v1/health)
MIN_CLIENT_VERSION=1.0.0
LATEST_CLIENT_VERSION=1.0.0

# Encrypted Daily Backup Key (AES-256 — generate: openssl rand -base64 32)
BACKUP_ENC_KEY=CHANGE_ME_STRONG_BACKUP_ENCRYPTION_KEY
BACKUP_RETENTION_DAYS=30
